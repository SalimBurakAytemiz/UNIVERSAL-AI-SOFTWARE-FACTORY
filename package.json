  "description": "Universal AI Technology Factory — P0 Factory Kernel (Architecture Baseline V1)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
