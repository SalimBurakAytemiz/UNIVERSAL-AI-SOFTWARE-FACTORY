# Placeholders only. Never commit real values here or anywhere in this
# public repository (see SECURITY.md and baseline section 154 "Secret Management").
#
# The P0 kernel's core tests never require any of these — MockProvider
# (runtime/models/providers/mock-provider.ts) is the default, free, offline
# model provider used by all unit tests and proofs.

# Model provider API keys (only needed if you enable a real provider adapter)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional local database URL, once a real state store replaces the file-based
# durable state under project-state/
DATABASE_URL=

# Factory-level cost ceilings (see runtime/budget). Leave unset to use the
# conservative built-in defaults.
FACTORY_DAILY_AI_BUDGET_USD=
FACTORY_MONTHLY_AI_BUDGET_USD=
